{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "job-ai-backend",
	"main": "server.js",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "job-ai-db",
			"database_id": "5d6e5a34-b240-463a-a14a-519538fd2fc4"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "jobassistantpremium"
		}
	]
}